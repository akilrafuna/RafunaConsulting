---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  /** object-position for the crop inside the oval */
  position?: string;
  /** Ground the vignette sits on, so its engraved rings separate correctly. */
  on?: 'ink' | 'paper';
  eager?: boolean;
  class?: string;
}
const {
  src,
  alt,
  sizes = '(min-width: 64rem) 32vw, 80vw',
  position = '50% 50%',
  on = 'paper',
  eager = false,
  class: className,
} = Astro.props;
---

<figure class:list={['vig', `vig-on-${on}`, className]}>
  <div class="vig-oval">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[360, 560, 820, 1100]}
      width={820}
      sizes={sizes}
      quality={62}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="vig-img"
      style={`object-position:${position}`}
    />
  </div>
</figure>

<style>
  .vig {
    --ring-gap: 0.55rem;
    position: relative;
    margin: 0;
    padding: calc(var(--ring-gap) + 2px);
  }
  .vig::before,
  .vig::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  /* double engraved ring */
  .vig::before {
    inset: 0;
    border: 1px solid var(--vig-ring);
  }
  .vig::after {
    inset: 4px;
    border: 1px solid color-mix(in oklab, var(--vig-ring) 55%, transparent);
  }
  .vig-on-paper {
    --vig-ring: var(--ink);
  }
  .vig-on-ink {
    --vig-ring: var(--paper);
  }
  .vig-oval {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 50%;
    overflow: hidden;
    isolation: isolate;
    background: var(--paper);
  }
  .vig-oval :global(picture),
  .vig-oval :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .vig-oval :global(img) {
    object-fit: cover;
    filter: grayscale(1) contrast(1.12) brightness(1.06);
    mix-blend-mode: multiply;
  }
  /* shadows take the intaglio navy */
  .vig-oval::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    mix-blend-mode: lighten;
    z-index: 1;
  }
  /* engraving line-screen */
  .vig-oval::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: repeating-linear-gradient(
      172deg,
      color-mix(in oklab, var(--ink) 30%, transparent) 0 1px,
      transparent 1px 3.2px
    );
    mix-blend-mode: multiply;
    pointer-events: none;
  }
</style>
