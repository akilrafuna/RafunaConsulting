---
import { Image } from 'astro:assets';
import mark from '@/assets/brand/mark.png';
import { heroRosette } from '@/lib/guilloche';

interface Props {
  class?: string;
  /** Element whose scroll progress turns the rings. Defaults to the rosette itself. */
  scrollTrigger?: string;
}
const { class: className, scrollTrigger } = Astro.props;
---

<div class:list={['rosette', className]} data-rosette data-trigger={scrollTrigger} aria-hidden="true">
  {heroRosette.map((ring, i) => <svg class={`rose-ring ink-${ring.ink}`} viewBox="-500 -500 1000 1000" data-ring={i} />)}
  <Image src={mark} alt="" class="watermark" width={200} height={123} loading="eager" />
</div>

<script>
  import { heroRosette, ringPaths } from '@/lib/guilloche';
  import { gsap, reducedMotion } from '@/scripts/motion';

  const NS = 'http://www.w3.org/2000/svg';

  document.querySelectorAll<HTMLElement>('[data-rosette]').forEach((root) => {
    const svgs = Array.from(root.querySelectorAll<SVGSVGElement>('svg[data-ring]'));
    svgs.forEach((svg, i) => {
      const frag = document.createDocumentFragment();
      for (const d of ringPaths(heroRosette[i].ring)) {
        const p = document.createElementNS(NS, 'path');
        p.setAttribute('d', d);
        frag.appendChild(p);
      }
      svg.appendChild(frag);
    });

    // Keep strokes at a true hairline whatever size the rosette renders at.
    const hairline = () => root.style.setProperty('--sw', String((0.8 * 1000) / Math.max(root.clientWidth, 1)));
    hairline();
    new ResizeObserver(hairline).observe(root);

    root.classList.add('is-ready');
    if (reducedMotion) return;

    // The one authored moment: the plate engraves itself, outside in.
    const tl = gsap.timeline({ delay: 0.2 });
    svgs.forEach((svg, i) => {
      const paths = svg.querySelectorAll('path');
      gsap.set(paths, { drawSVG: '0%' });
      tl.to(paths, { drawSVG: '100%', duration: 2.2, ease: 'expo.out', stagger: 0.025 }, i * 0.22);
    });
    tl.fromTo(root.querySelector('.watermark'), { opacity: 0, scale: 0.92 }, { opacity: 1, scale: 1, duration: 1.4, ease: 'expo.out' }, 0.9);

    // Rose engine: rings counter-rotate with scroll, shifting the moiré.
    const trigger = root.dataset.trigger ? document.querySelector(root.dataset.trigger) : root;
    svgs.forEach((svg, i) => {
      gsap.to(svg, {
        rotate: heroRosette[i].spin * (10 + i * 7),
        ease: 'none',
        scrollTrigger: { trigger: trigger ?? root, start: 'top top', end: 'bottom top', scrub: 0.6 },
      });
    });
  });
</script>

<style>
  .rosette {
    position: relative;
    aspect-ratio: 1;
    contain: layout paint;
  }
  .rose-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-width: var(--sw, 1);
    stroke-linejoin: round;
    will-change: transform;
  }
  .rose-ring :global(path) {
    fill: none;
  }
  .ink-teal {
    stroke: var(--teal-glow);
    opacity: 0.72;
  }
  .ink-orange {
    stroke: var(--orange);
    opacity: 0.78;
  }
  .ink-paper {
    stroke: var(--paper);
    opacity: 0.42;
  }
  .watermark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18%;
    height: auto;
    translate: -54% -50%;
  }
</style>
